{
  "name": "kivopolis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/theatre.test.ts tests/voxel.test.ts tests/items.test.ts tests/world-life.test.ts tests/water.test.ts tests/settings.test.ts tests/island.test.ts tests/buildings.test.ts tests/shared.test.ts tests/rooms.test.ts tests/sanctuary.test.ts tests/agora.test.ts tests/stadium.test.ts tests/survival.test.ts",
    "test:e2e": "playwright test",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/index.mjs",
    "server": "npm run build:server && node server/dist/index.mjs",
    "load-check": "esbuild server/load-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/load-check.mjs && node server/dist/load-check.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/noto-serif": "^5.2.8",
    "@fontsource/tiny5": "^5.3.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.0",
    "ws": "^8.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
